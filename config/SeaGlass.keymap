#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        cmbEsc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 0>;
        };

        cmbEng {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <27 26>;
        };

        cmbJp {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <22 23>;
        };

        cmbMinus {
            bindings = <&kp MINUS>;
            key-positions = <18 19>;
        };

        cmbSingle {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <28 29>;
        };

        cmbMB2 {
            bindings = <&mkp MB2>;
            key-positions = <13 12>;
        };

        cmbMB3 {
            bindings = <&mkp MB3>;
            key-positions = <20 21>;
        };

        cmbMB3_2 {
            bindings = <&mkp MB3>;
            key-positions = <40 41>;
        };

        cmbTog6 {
            bindings = <&tog 6>;
            key-positions = <29 39>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        space4: space4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp SPACE &kp SPACE &kp SPACE>;
            label = "SPACE4";
        };

        left4: left4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT &kp LEFT &kp LEFT &kp LEFT>;
            label = "LEFT4";
        };

        right4: right4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT>;
            label = "RIGHT4";
        };

        dlThem: dlThem {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_ALT &kp T>,
                <&macro_wait_time 100>,
                <&kp UP_ARROW>,
                <&macro_wait_time 100>,
                <&kp RIGHT>,
                <&macro_wait_time 100>,
                <&kp DOWN>,
                <&macro_wait_time 100>,
                <&kp ENTER>;

            label = "DLTHEM";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        rsr_scroll_ud: rsr_scroll_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_UP>;
            ccw-binding = <&msc SCRL_DOWN>;
        };

        rsr_scroll_lr: rsr_scroll_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_RIGHT>;
            ccw-binding = <&msc SCRL_LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q        &kp W        &lt 7 E         &kp R         &kp T      &lt 7 Y      &kp U            &kp I            &kp O        &kp P
&kp A        &mt LCTRL S  &mt LEFT_ALT D  &mt LSHIFT F  &kp G      &kp H        &mt RSHIFT J     &mt RIGHT_ALT K  &mt RCTRL L  &lt 3 SEMICOLON
&mt LCTRL Z  &mt LWIN X   &kp C           &kp V         &kp B      &kp N        &kp M            &kp COMMA        &kp PERIOD   &mt RIGHT_SHIFT SLASH
&none        &none        &mkp MB1        &lt 1 SPACE   &lt 5 TAB  &lt 5 ENTER  &lt 2 BACKSPACE  &none            &none        &none
                                                                   &mkp MB1     &mkp MB2
            >;

            sensor-bindings = <&rsr_scroll_ud &rsr_scroll_lr>;
            label = "BASE";
        };

        sym {
            bindings = <
&kp DELETE       &kp F7        &kp F8           &kp F9         &kp F12  &kp AMPERSAND    &kp ASTERISK        &kp BACKSLASH        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &mt LCTRL F4  &mt LEFT_ALT F5  &mt LSHIFT F6  &kp F11  &kp DOLLAR       &mt RSHIFT PERCENT  &mt RIGHT_ALT CARET  &mt RCTRL MINUS       &mt SQT EQUAL
&kp PRINTSCREEN  &kp F1        &kp F2           &kp F3         &kp F10  &kp EXCLAMATION  &kp AT_SIGN         &kp HASH             &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans           &trans        &trans           &trans         &trans   &trans           &trans              &trans               &trans                &trans
                                                                        &trans           &trans
            >;

            label = "SYM";
        };

        num {
            bindings = <
&kp COLON  &kp N7              &kp N8           &kp N9               &kp MINUS  &left4    &trans     &trans        &right4    &kp BSPC
&kp N0     &mt LCTRL NUMBER_4  &mt LEFT_ALT N5  &mt LSHIFT NUMBER_6  &kp FSLH   &kp LEFT  &kp DOWN   &kp UP_ARROW  &kp RIGHT  &trans
&kp DOT    &kp N1              &kp N2           &kp N3               &kp COMMA  &kp HOME  &kp PG_DN  &kp PG_UP     &kp END    &trans
&trans     &trans              &trans           &trans               &trans     &trans    &trans     &trans        &trans     &trans
                                                                                &trans    &trans
            >;

            label = "NUM";
        };

        browse {
            bindings = <
&trans             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &mo 6   &kp LC(T)      &kp LC(B)          &kp TAB       &kp LCTRL      &kp LS(LG(D))
&kp LC(LA(LS(P)))  &kp LA(N4)    &kp LA(N5)    &kp LA(N6)    &trans  &kp F4         &kp LA(LC(RIGHT))  &kp LA(LEFT)  &kp LA(RIGHT)  &trans
&trans             &kp LA(N1)    &kp LA(N2)    &kp LA(N3)    &trans  &kp LC(LA(T))  &kp LC(LA(R))      &kp LC(W)     &kp LA(P)      &mo 4
&trans             &trans        &trans        &trans        &trans  &mkp MB1       &mkp MB2           &trans        &trans         &trans
                                                                     &trans         &trans
            >;

            label = "BROWSE";
            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        none {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans       &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans
&trans       &trans  &trans  &trans  &trans  &bt BT_CLR      &trans        &trans        &trans        &trans
&trans       &trans  &trans  &trans  &trans  &trans          &trans        &trans        &trans        &trans
                                             &trans          &trans
            >;

            label = "NONE";
        };

        custom {
            bindings = <
&kp ESC              &kp LG(LS(C))     &kp LG(V)          &kp LG(LC(T))      &kp LG(LS(T))      &kp TAB  &kp LA(PRINTSCREEN)  &kp LC(C)  &kp LC(V)  &trans
&kp LS(LG(S))        &kp LCTRL         &kp LALT           &kp LSHFT          &trans             &trans   &kp RSHFT            &kp RALT   &kp RCTRL  &kp GRAVE
&kp LA(PRINTSCREEN)  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &kp LS(LG(RIGHT))  &kp LC(LS(LG(B)))  &dlThem  &kp LS(LG(RIGHT))    &trans     &kp RGUI   &kp INSERT
&trans               &trans            &trans             &space4            &trans             &trans   &trans               &trans     &trans     &trans
                                                                                                &trans   &trans
            >;

            label = "CUSTOM";
        };

        bronx {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &mo 7     &mt LG(DOWN) LG(UP_ARROW)  &kp LG(TAB)    &kp LC(LS(TAB))  &kp LC(TAB)
&trans  &trans  &trans  &trans  &trans  &mkp MB3  &kp LEFT                   &kp F11        &kp RIGHT        &kp LC(W)
&trans  &trans  &trans  &trans  &trans  &trans    &kp C_VOLUME_DOWN          &kp C_MUTE     &kp C_VOLUME_UP  &kp LS(LG(RIGHT))
&trans  &trans  &trans  &trans  &trans  &mkp MB1  &kp LA(LEFT)               &kp LA(RIGHT)  &trans           &dlThem
                                        &mkp MB2  &mkp MB3
            >;

            label = "BRONX";
            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans  &trans
            >;

            label = "SCROLL";
        };
    };
};
